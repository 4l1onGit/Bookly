# Copy this file to .env and fill in the values before running the project.


# Application environment
APP_ENV=dev
APP_SECRET=your_app_secret_here

# Database connection (example for MySQL)
DATABASE_URL="mysql://user:password@database:3306/bookly?serverVersion=8.0"

# JWT keys (paths remain the same)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here

# Notes:
# - Never commit your real .env file to version control.
# - Ensure the "public/books" directory is writable for image uploads.
# - For production, consider using S3 or another cloud storage provider.
# - Run doctrine migrations after configuring your database.